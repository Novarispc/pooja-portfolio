# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Admin login username
ADMIN_USERNAME=pooja

# Run: npm run hash-password -- "your-chosen-password"
# then paste the printed hash below.
ADMIN_PASSWORD_HASH=

# Any long random string — used to sign session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase Storage for file uploads + content persistence (free tier available)
# Get from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# service_role key — server-only, NEVER expose to the client. Used to read/write
# site content (data/content.json equivalent) and history snapshots in Supabase
# Storage, bypassing RLS. Required so admin Save/Publish works on Vercel, where
# the local filesystem is read-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
